# Runtime: URL pooled Neon (hostname mengandung -pooler). Jangan pakai NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@ep-PROJECT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# CLI migrations: URL direct untuk database/branch yang SAMA.
DIRECT_URL="postgresql://USER:PASSWORD@ep-PROJECT.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# development atau production: wajib dipilih sebelum migrasi/seed/bootstrap.
DB_TARGET="development"
APP_ORIGIN="http://localhost:3000"
# Hasil: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
# Bootstrap hanya akun pertama. Minimum 12 karakter, huruf besar/kecil, angka, simbol.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Opsional: database TEST terpisah; tidak pernah gunakan database aplikasi/production.
TEST_DATABASE_URL=""
