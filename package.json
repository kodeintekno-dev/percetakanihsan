{
  "name": "percetakan-cv-ihsan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "tsx scripts/migrate.ts",
    "seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "decimal.js": "10.6.0",
    "dotenv": "^17.2.3",
    "exceljs": "4.4.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.4",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "csv-parse": "6.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.4",
    "prisma": "7.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
